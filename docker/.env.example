# Chép thành docker/.env rồi đổi mật khẩu. File .env KHÔNG vào git.

# Tài khoản quản trị MinIO — chỉ dùng để đăng nhập console và chạy init.
MINIO_ROOT_USER=lsth-admin
MINIO_ROOT_PASSWORD=doi-mat-khau-nay-di-1234

# Tài khoản mà lsth-mcp dùng. Bị cấm ghi vào lsth-raw và cấm xoá mọi thứ.
LSTH_S3_ACCESS_KEY=lsth-app
LSTH_S3_SECRET_KEY=doi-mat-khau-nay-nua-5678

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
