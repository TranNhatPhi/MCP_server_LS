# Chép thành .env và điền. File .env KHÔNG vào git.

# Ai đang gọi và với vai trò gì (đè lên config/settings.yaml)
LSTH_ACTOR=phi
LSTH_ROLE=engineer_sandbox

# Nguyên tắc 2 — bật lên khi đã sẵn sàng cho phép ghi.
# Từng server vẫn phải qua cổng write_gates riêng, biến này chỉ là công tắc chung.
LSTH_WRITE_ENABLED=false

# Chế độ chạy
LSTH_TRANSPORT=stdio
LSTH_HTTP_HOST=127.0.0.1
LSTH_HTTP_PORT=8787

# --- Chưa dùng tới, chờ lấp khoảng trống dữ liệu ---

# ERP LSTH — địa chỉ đã biết từ cẩm nang nội bộ (xem docs/ERP_MAP.md).
# ERP có app di động trên App Store và Google Play, nên phía sau chắc chắn có một
# API HTTP. Còn chờ G1: xin tài liệu API đó và một tài khoản riêng cho tự động hoá.
LSTH_ERP_BASE_URL=https://erp-app.erpleadingstar.com
LSTH_ERP_PURCHASING_URL=https://internalpurchasing.erpleadingstar.com
LSTH_ERP_API_KEY=
# Tài khoản riêng cho tự động hoá — KHÔNG dùng tài khoản cá nhân.
# Lưu ý: cẩm nang ghi mật khẩu mặc định toàn hệ thống là 123456; hỏi IT đã rà chưa.
LSTH_ERP_USER=
LSTH_ERP_PASS=

# S4 lsth-mail: chỉ đọc và soạn nháp, KHÔNG cấp quyền gửi (nguyên tắc 1)
LSTH_MAIL_TENANT_ID=
LSTH_MAIL_CLIENT_ID=
LSTH_MAIL_CLIENT_SECRET=

# M5: tài khoản riêng cho tự động hoá, xin khách cấp — không dùng tài khoản cá nhân
LSTH_PORTAL_SYMPAREL_USER=
LSTH_PORTAL_SYMPAREL_PASS=
